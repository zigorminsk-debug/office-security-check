 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Office Security Check"
            VALUE "FileDescription", "Security Audit (Audit Zashchity)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SecurityAudit"
            VALUE "LegalCopyright", "Office Security Check"
            VALUE "OriginalFilename", "SecurityAudit.exe"
            VALUE "ProductName", "Office Security Check - Security Audit"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
