// Compiled by MinGW windres into app.syso and linked into the exe by go build.
// NOTE: keep this file ASCII-only for compatibility with GNU windres.

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
